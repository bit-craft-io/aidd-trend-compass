MYSQL_DATABASE=trend_compass
MYSQL_USER=trend
MYSQL_PASSWORD=trend
MYSQL_ROOT_PASSWORD=root
# 未設定の場合、詳細画面のニュース欄は空(取得できない状態)になる
ANTHROPIC_API_KEY=
# 発掘機能: J-Quants APIダッシュボードで発行したAPIキー。未設定の場合、発掘の「取得」ボタンは無効化される
JQUANTS_API_KEY=
JQUANTS_BASE_URL=https://api.jquants.com/v2
JQUANTS_RATE_LIMIT_PER_64S=5
JQUANTS_MAX_STOCKS=10
# トレンド判定(日足): 短期・長期の移動平均の期間(日)と、横ばいとみなす差の閾値(%)
TREND_SHORT_PERIOD=5
TREND_LONG_PERIOD=25
TREND_FLAT_BAND_PCT=1.0
